# RecoverAI Backend Environment Configuration

APP_NAME=RecoverAI
APP_ENV=development
LOG_LEVEL=INFO
API_VERSION=v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/recoverai_db

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Razorpay Test Mode Configuration (Optional)
# Options: TEST_MODE (Default local simulation) | RAZORPAY_PAYMENT_LINK (Razorpay Payment Links API)
EXECUTION__RAZORPAY_PROVIDER_TYPE=TEST_MODE
EXECUTION__RAZORPAY_KEY_ID=
EXECUTION__RAZORPAY_KEY_SECRET=
